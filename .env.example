# 개인 키만 .env.local에 넣으세요. 이 파일에는 실제 값을 넣지 마세요.
KAKAO_REST_API_KEY=
# Places API (New) 활성화와 결제 계정 연결이 필요합니다. 월 무료 사용량·예산 알림을 함께 설정하세요.
GOOGLE_MAPS_API_KEY=
# YouTube Data API v3를 활성화한 Google Cloud API 키입니다.
YOUTUBE_API_KEY=
KTO_SERVICE_KEY=

# 공용 OSM 인스턴스는 개인·저빈도 사용에만 적합합니다.
OSM_PROVIDER_MODE=public
